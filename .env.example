# All optional. With no keys the app runs in demo mode (library works; live generation is simulated).

# LLM — Groq (primary). Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# LLM — Gemini (fallback, used if GROQ_API_KEY is empty). Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web search for the research agent. OPTIONAL: without a key Tavily runs in keyless mode
# (free, low hourly cap), and if that's exhausted the agent falls back to crawling docs itself.
# A free key (1,000 credits/month, no credit card) raises the limits: https://app.tavily.com
TAVILY_API_KEY=
# Set to "crawl" to skip web search entirely and only use the built-in docs crawler.
SEARCH_PROVIDER=

# Persist generated guides so share links survive restarts (Vercel Blob). Optional locally.
BLOB_READ_WRITE_TOKEN=
